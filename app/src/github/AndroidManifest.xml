<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- GitHub 渠道支持工作区直接映射 /sdcard（配合防误删回收站保护与 Root 自动授权） -->
  <uses-permission
    android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
    tools:ignore="ScopedStorage" />
  <uses-permission
    android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="32" />

  <application>
    <!-- Phone Use：只在 github 渠道声明，Play 不允许用无障碍服务做自动化。
         Android 11 以下不启用，系统的无障碍设置里不会出现这一项 -->
    <service
      android:name=".phoneuse.PhoneUseAccessibilityService"
      android:enabled="@bool/phone_use_supported"
      android:exported="true"
      android:label="@string/phone_use_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/phone_use_accessibility" />
    </service>

    <!-- Sui / Shizuku Binder 接收与自动初始化（仅在 GitHub 渠道启用，onCreate 内自动执行 Sui.init） -->
    <provider
      android:name="rikka.shizuku.ShizukuProvider"
      android:authorities="${applicationId}.shizuku"
      android:enabled="true"
      android:exported="true"
      android:multiprocess="false"
      android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
  </application>

</manifest>
